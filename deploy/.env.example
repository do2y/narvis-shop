# 데모 배포 환경변수 — 이 파일을 .env 로 복사해 채운다 (.env 는 커밋 금지).
#
# 시크릿 7종은 손으로 만들지 말고:  bash scripts/gen-secrets.sh >> .env

# ── 공개 주소 (Cloudflare Tunnel 에 등록한 호스트명) ──
# 쇼핑몰 오리진. 쿠키가 Secure 라 반드시 https 다.
SITE_URL=https://narvis.example.com
# AI SSE 오리진. 브라우저가 **직접** 여는 주소이며, 백엔드가 뒤에
# /chat · /seller/chat 을 붙여 llmSseUrl 로 내려준다 → 경로 없이 오리진만 적는다.
AI_PUBLIC_URL=https://ai-narvis.example.com

# Cloudflare Zero Trust → Networks → Tunnels 에서 만든 터널의 토큰.
# 위 두 호스트명을 각각 app-web:80 / app-ai:8000 으로 라우팅해 두어야 한다.
TUNNEL_TOKEN=

# ── 레포 위치 (compose 가 이미지를 빌드할 경로) ──
# 기본값은 세 레포를 나란히 둔 배치(project/jarvis-{web,backend,ai}) 기준.
BACKEND_REPO_PATH=../../jarvis-backend
AI_REPO_PATH=../../jarvis-ai

# ── DB ──
DB_NAME=jarvis
DB_USERNAME=jarvis

# ── 프록시 홉 수 ──
# Cloudflare Tunnel → app-web 내장 nginx = 2홉. 틀리면 로그인 rate-limit 이
# 엉뚱한 IP 를 세어 오작동한다(정상 사용자가 막히거나, 제한이 안 걸린다).
APP_CLIENT_IP_FORWARDED_DEPTH=2

# ── 시크릿 (gen-secrets.sh 가 아래를 채운다) ──
# JWT_SECRET=
# INTERNAL_API_TOKEN=          BE·AI 동일 값이어야 한다
# PII_HASH_PEPPER=              AI 서버 jwks 모드 필수
# CUSTOMER_LABEL_SECRET=
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# PG_PASSWORD=
# STREAM_TICKET_PRIVATE_KEY=
# STREAM_TICKET_KID=
